# 12: a big document: 20,000 runs, a deep left chain, splits and deletes
c = 12
a = Writer(c, "colin")
seed = 12345


def rnd(n):
    global seed
    seed = (seed * 1103515245 + 12345) % 2 ** 31
    return seed % n


words = ["field", "text", "run", "event", "fugue", "doc", "node", "page", "", "wisp"]
evs, runs, n = [], 0, 1
while runs < 20000:
    edits, size, mode = [], 0, n % 3
    vis = len(a.t.visible())
    cur = rnd(vis + 1)
    while size < 14000 and runs < 20000:
        w = words[rnd(len(words))] or "é😀"
        if mode == 0:                               # typing backwards at the start
            edits.append((0, 0, w + " ")); size += 16
        elif mode == 1:                             # writing on with corrections
            if rnd(5) == 0 and cur > 3:
                cur -= rnd(3) + 1
            edits.append((cur, 0, w + " ")); cur += len(w) + 1; size += 18
        else:                                       # scattered edits and deletes
            vis = len(a.t.visible()) + sum(len(e[2]) - e[1] for e in edits)
            p = rnd(vis + 1)
            d = min(rnd(4) if rnd(3) == 0 else 0, vis - p)
            edits.append((p, d, w)); size += 90 + 85 * (d > 0)
        runs += 1
    ev = a.edit(n, edits)
    while len(body_part(ev).encode()) > 16384:
        raise SystemExit(f"big: event {n} body too large")
    evs.append(ev)
    n += 1
case("big", f"{runs} runs in {len(evs)} events: a long left chain, splits, deletes; walks must loop, not recurse",
     evs, big=True)

