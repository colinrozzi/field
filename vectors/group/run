#!/usr/bin/env python3
"""Check field/groupmodel.wisp (through mailmodel.wisp, which keeps one)
against the group vectors (README.md here).

    field/vectors/group/run [CASE.json ...]

Uses field/vectors/chat/run's private daemon (its own port and filesystem
root; nothing touches the real node) and feeds each event to mail-add.
"""
import importlib.machinery, importlib.util, json, sys

sys.dont_write_bytecode = True
from pathlib import Path

HERE = Path(__file__).resolve().parent
_loader = importlib.machinery.SourceFileLoader("chatrun", str(HERE.parent / "chat" / "run"))
_spec = importlib.util.spec_from_loader("chatrun", _loader)
chatrun = importlib.util.module_from_spec(_spec)
_loader.exec_module(chatrun)
wstr, lst, canon = chatrun.wstr, chatrun.lst, chatrun.canon


def pairs(d, form):
    """A Wisp list of (key value) -> a dict."""
    out = lst(d.eval(f'(join-l (map (lambda (kv) (string-append (car kv) " " (list-get kv 1))) {form}))'))
    return dict(x.split(" ", 1) for x in out)


def check(d, case):
    dirn = "gv-" + case["name"]
    D, G = wstr(dirn), wstr(dirn + "/group")
    d.eval(f'(mail-start {D})')
    addressed = {}
    for id_, scope, kind, text in case["events"]:
        out = d.eval(f'(join-l (mail-add {D} {wstr(id_)} {wstr(scope)} {wstr(kind)} {wstr(canon(text))}))')
        addressed[id_] = sorted(lst(out))
    fails = []
    exp = case["expect"]
    for g, want in exp.get("direct", {}).items():
        got = pairs(d, f'(group-direct {G} {wstr(g)})')
        if got != want:
            fails.append(f"direct {g}: {got!r} != {want!r}")
    for g, want in exp.get("groups", {}).items():
        got = pairs(d, f'(group-members {G} {wstr(g)})')
        if got != want:
            fails.append(f"groups {g}: {got!r} != {want!r}")
    for g, want in exp.get("open", {}).items():
        got = d.eval(f'(group-open? {G} {wstr(g)})') == "1"
        if got != want:
            fails.append(f"open {g}: {got!r} != {want!r}")
    for b, want in exp.get("members", {}).items():
        got = sorted(lst(d.eval(f'(join-l (mail-members {D} {wstr(b)}))')))
        if got != sorted(want):
            fails.append(f"members {b}: {got!r} != {sorted(want)!r}")
    for id_, want in exp.get("addressed", {}).items():
        if addressed.get(id_) != sorted(want):
            fails.append(f"addressed ..{id_[-2:]}: {addressed.get(id_)!r} != {sorted(want)!r}")
    return fails


def main():
    files = [Path(a) for a in sys.argv[1:]] or sorted(HERE.glob("*.json"))
    bad = 0
    with chatrun.Daemon() as d:
        d.eval(chatrun.JOIN)
        d.eval('(require mailmodel "experiment/field/mailmodel.wisp")')
        d.eval('(require groupmodel "experiment/field/groupmodel.wisp")')
        for f in files:
            case = json.loads(f.read_text())
            try:
                fails = check(d, case)
            except RuntimeError as e:
                fails = [f"error: {e}"]
            print(("ok   " if not fails else "FAIL ") + f.name)
            for x in fails:
                print("     " + x)
            bad += bool(fails)
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
