def eid(case, n):
    return f"f{case}" + "0" * (62 - len(str(n))) + str(n)


def event(case, n, kind, headers, text=None, scope="chat/main", parents=()):
    body = "".join(f"{k} {v}\n" for k, v in headers) + ("" if text is None else "\n" + text)
    lines = ["sig " + "0" * 128, "field 1", "author " + AUTHOR, "scope " + scope, "kind " + kind,
             f"time {T0 + n * 1000}"] + [f"parent {p}" for p in sorted(parents)]
    lines.append(f"body {len(body.encode())}")
    return [eid(case, n), scope, kind, "\n".join(lines) + "\n" + body]


def add(case, n, g, frm, who, role=None):
    return event(case, n, "group.add", [("from", frm), ("who", who)] + ([("role", role)] if role else []), scope=f"group/{g}")


def rm(case, n, g, frm, who):
    return event(case, n, "group.remove", [("from", frm), ("who", who)], scope=f"group/{g}")


def opn(case, n, g, frm, v):
    return event(case, n, "group.open", [("from", frm), ("open", v)], scope=f"group/{g}")


